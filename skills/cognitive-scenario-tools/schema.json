{
  "schema_version": "1.0",
  "title": "Cognitive Scenario Tools Contract",
  "input_schema": {
    "type": "object",
    "required": ["scenario", "observed_facts"],
    "properties": {
      "scenario": {
        "type": "string",
        "enum": [
          "relationship_and_communication",
          "negotiation_and_cooperation",
          "shared_resources_and_organizations",
          "competition_and_strategy",
          "personal_growth",
          "public_expression_and_persuasion",
          "mixed",
          "unknown"
        ]
      },
      "observed_facts": {
        "type": "array",
        "items": { "type": "string" }
      },
      "interpretations": {
        "type": "array",
        "items": { "type": "string" }
      },
      "emotions": {
        "type": "array",
        "items": { "type": "string" }
      },
      "desired_action": {
        "type": "string"
      },
      "stakeholders": {
        "type": "array",
        "items": { "type": "string" }
      },
      "constraints": {
        "type": "array",
        "items": { "type": "string" }
      },
      "risk_level": {
        "type": "string",
        "enum": ["low", "medium", "high", "unknown"]
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["facts_observed", "models_used", "next_verifiable_action"],
    "properties": {
      "facts_observed": {
        "type": "array",
        "items": { "type": "string" }
      },
      "models_used": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": {
          "type": "object",
          "required": ["name", "why"],
          "properties": {
            "name": { "type": "string" },
            "why": { "type": "string" }
          }
        }
      },
      "strongest_interpretation": {
        "type": "string"
      },
      "plausible_alternatives": {
        "type": "array",
        "items": { "type": "string" }
      },
      "risk_of_over_inference": {
        "type": "string",
        "enum": ["low", "medium", "high"]
      },
      "next_verifiable_action": {
        "type": "string"
      }
    }
  }
}
