{
  "schema_version": "1.0",
  "title": "Cognitive Analysis Tools Contract",
  "input_schema": {
    "type": "object",
    "required": [
      "problem_definition",
      "analysis_need"
    ],
    "properties": {
      "problem_definition": {
        "type": "string",
        "description": "The already-defined problem from the core operating skill."
      },
      "analysis_need": {
        "type": "string",
        "description": "Why deeper model-based reasoning is needed."
      },
      "known_facts": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "assumptions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "options": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "constraints": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "risk_level": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high",
          "unknown"
        ]
      },
      "task_type": {
        "type": "string",
        "enum": [
          "cognition",
          "decision",
          "system",
          "uncertainty",
          "feedback",
          "growth",
          "product_readiness",
          "system_readiness",
          "mixed"
        ]
      },
      "target_stage": {
        "type": "string",
        "enum": [
          "mvp_build",
          "self_use",
          "friend_alpha",
          "initial_release",
          "broader_rollout",
          "unknown"
        ],
        "description": "Optional next product or system maturity stage when system completeness is being evaluated."
      },
      "system_context": {
        "type": "string",
        "description": "Optional summary of the product, workflow, or agentic system being evaluated."
      },
      "current_stage": {
        "type": "string",
        "enum": [
          "idea",
          "prototype",
          "mvp_build",
          "self_use",
          "friend_alpha",
          "initial_release",
          "broader_rollout",
          "unknown"
        ],
        "description": "Optional current product or system maturity stage when system completeness is being evaluated."
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "selected_models",
      "analysis",
      "next_action"
    ],
    "properties": {
      "selected_models": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": {
          "type": "object",
          "required": [
            "name",
            "reason"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          }
        }
      },
      "analysis": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "model",
            "finding"
          ],
          "properties": {
            "model": {
              "type": "string"
            },
            "finding": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "limits": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "decision_or_test": {
        "type": "string",
        "description": "The decision, experiment, or verification generated by the analysis."
      },
      "next_action": {
        "type": "string"
      },
      "system_completeness_assessment": {
        "type": "object",
        "properties": {
          "current_stage": {
            "type": "string"
          },
          "target_stage": {
            "type": "string"
          },
          "dimension_scores": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "dimension",
                "score",
                "evidence"
              ],
              "properties": {
                "dimension": {
                  "type": "string"
                },
                "score": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                },
                "evidence": {
                  "type": "string"
                },
                "blocker": {
                  "type": "boolean"
                }
              }
            }
          },
          "stage_gate_decision": {
            "type": "string"
          },
          "smallest_next_increment": {
            "type": "string"
          },
          "exit_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deferred_backlog": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
