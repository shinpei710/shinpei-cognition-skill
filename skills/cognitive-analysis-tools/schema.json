{
  "schema_version": "1.0",
  "title": "Cognitive Analysis Tools Contract",
  "input_schema": {
    "type": "object",
    "required": ["problem_definition", "analysis_need"],
    "properties": {
      "problem_definition": {
        "type": "string",
        "description": "The already-defined problem from the core operating skill."
      },
      "analysis_need": {
        "type": "string",
        "description": "Why deeper model-based reasoning is needed."
      },
      "known_facts": {
        "type": "array",
        "items": { "type": "string" }
      },
      "assumptions": {
        "type": "array",
        "items": { "type": "string" }
      },
      "options": {
        "type": "array",
        "items": { "type": "string" }
      },
      "constraints": {
        "type": "array",
        "items": { "type": "string" }
      },
      "risk_level": {
        "type": "string",
        "enum": ["low", "medium", "high", "unknown"]
      },
      "task_type": {
        "type": "string",
        "enum": ["cognition", "decision", "system", "uncertainty", "feedback", "growth", "mixed"]
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["selected_models", "analysis", "next_action"],
    "properties": {
      "selected_models": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": {
          "type": "object",
          "required": ["name", "reason"],
          "properties": {
            "name": { "type": "string" },
            "reason": { "type": "string" }
          }
        }
      },
      "analysis": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["model", "finding"],
          "properties": {
            "model": { "type": "string" },
            "finding": { "type": "string" },
            "evidence": {
              "type": "array",
              "items": { "type": "string" }
            },
            "limits": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      },
      "decision_or_test": {
        "type": "string",
        "description": "The decision, experiment, or verification generated by the analysis."
      },
      "next_action": {
        "type": "string"
      }
    }
  }
}
